        "url": {
          "raw": "{{baseUrl}}/submit-form/",
          "host": ["{{baseUrl}}"],
          "path": ["submit-form", ""]
        },
        "description": "Email value present but not a valid email format. Expected: 4xx validation error. NOTE: UI testing today found the phone equivalent of this case (invalid format shown, but client-side message did NOT actually block the request) - worth confirming server-side email validation is real and not just cosmetic, the same way phone validation turned out to be."
      },
      "event": [
        {
          "listen": "test",
          "script": {
