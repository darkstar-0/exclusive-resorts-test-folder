        "body": {
          "mode": "raw",
          "raw": "{\n  \"values\": \"Email=not-an-email&Phone=4235559876&FirstName=API&LastName=BadEmail&ZIP=80014&termsAgreement=true&FBID=&GCLID=&msclkid=&C_SFDCLastCampaignID=&C_Page_URL=https%3A%2F%2Fpublic-site.stage.exclusiveresorts.com%2Finquire%2F&smsOptIn=&preferredTime=&preferredDate=&preferredContactType=Email&Braze_Campaign_ID=&Referrer_URL=\",\n  \"form\": \"SHORT_FORM\"\n}"
