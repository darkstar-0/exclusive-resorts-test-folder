    {
      "name": "API-07 - Response Time (p95)",
      "item": [
        {
          "name": "Valid Submission (run x10 via Newman -n)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"values\": \"Email=qa.candidate%2Bapi.perf%40gmail.com&Phone=4235559876&FirstName=API&LastName=Perf&ZIP=80014&termsAgreement=true&FBID=&GCLID=&msclkid=&C_SFDCLastCampaignID=&C_Page_URL=https%3A%2F%2Fpublic-site.stage.exclusiveresorts.com%2Finquire%2F&smsOptIn=&preferredTime=&preferredDate=&preferredContactType=Email&Braze_Campaign_ID=&Referrer_URL=\",\n  \"form\": \"SHORT_FORM\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/submit-form/",
              "host": ["{{baseUrl}}"],
              "path": ["submit-form", ""]
            },
            "description": "Run this request 10 times (this folder in isolation, via Newman -n 10 or the Postman Collection Runner) to sample p95 response time."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let times = JSON.parse(pm.collectionVariables.get('responseTimes') || '[]');",
                  "times.push(pm.response.responseTime);",
                  "pm.collectionVariables.set('responseTimes', JSON.stringify(times));",
                  "",
                  "const totalIterations = parseInt(pm.environment.get('perfIterations') || '10', 10);",
                  "",
                  "pm.test('Individual response is under 2000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "if (times.length >= totalIterations) {",
                  "    const sorted = [...times].sort(function (a, b) { return a - b; });",
                  "    const p95Index = Math.ceil(0.95 * sorted.length) - 1;",
                  "    const p95 = sorted[p95Index];",
                  "    pm.test('p95 response time (' + p95 + 'ms) over ' + times.length + ' calls is under 2000ms', function () {",
                  "        pm.expect(p95).to.be.below(2000);",
                  "    });",
                  "    pm.collectionVariables.set('responseTimes', '[]');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
