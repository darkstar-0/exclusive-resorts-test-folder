{
  "info": {
    "_postman_id": "b3f2a6b0-6e2e-4c1a-9c0a-exres-inquiry-api",
    "name": "Exclusive Resorts - Inquiry Form Submit API",
    "description": "Exercises POST {{baseUrl}}/submit-form/, the backend endpoint the /inquire/ form posts to.\n\nIMPORTANT: the request shape below is captured from a real browser network request (via Playwright route interception during UI testing). The RESPONSE shapes and exact status codes asserted here are best-effort inferences, NOT confirmed against a live, unmocked server — every capture we had access to was intercepted and stubbed before it reached the real backend. Run this collection against real staging first and adjust the response-shape/status assertions (marked ADJUST AFTER LIVE RUN below) to match what actually comes back.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "responseTimes", "value": "[]" }
  ],
  "item": [
    {
      "name": "API-01 - Valid Submission (200 Baseline)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"values\": \"Email=qa.candidate%2Bapi.valid%40gmail.com&Phone=4235559876&FirstName=API&LastName=Valid&ZIP=80014&termsAgreement=true&FBID=&GCLID=&msclkid=&C_SFDCLastCampaignID=&C_Page_URL=https%3A%2F%2Fpublic-site.stage.exclusiveresorts.com%2Finquire%2F&smsOptIn=&preferredTime=&preferredDate=&preferredContactType=Email&Braze_Campaign_ID=&Referrer_URL=\",\n  \"form\": \"SHORT_FORM\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/submit-form/",
          "host": ["{{baseUrl}}"],
          "path": ["submit-form", ""]
        },
        "description": "Baseline happy-path submission, captured from a real UI-driven request. Expected: 2xx with a success payload."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 2xx', function () {",
              "    pm.expect(pm.response.code).to.be.within(200, 299);",
              "});",
              "",
              "pm.test('Response time is reasonable (<2000ms)', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "pm.test('Response body is valid JSON', function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "// ADJUST AFTER LIVE RUN: exact success-payload shape is unconfirmed.",
              "pm.test('Response indicates success (ADJUST AFTER LIVE RUN)', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.be.an('object');",
              "});"
            ]
          }
        }
      ]
    },
