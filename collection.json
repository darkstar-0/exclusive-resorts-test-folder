    {
      "name": "API-05 - POST With SQL Injection Payload in Name",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"values\": \"Email=qa.candidate%2Bapi.sqli%40gmail.com&Phone=4235559876&FirstName=Robert%27%29%3B%20DROP%20TABLE%20Students%3B--&LastName=Tables&ZIP=80014&termsAgreement=true&FBID=&GCLID=&msclkid=&C_SFDCLastCampaignID=&C_Page_URL=https%3A%2F%2Fpublic-site.stage.exclusiveresorts.com%2Finquire%2F&smsOptIn=&preferredTime=&preferredDate=&preferredContactType=Email&Braze_Campaign_ID=&Referrer_URL=\",\n  \"form\": \"SHORT_FORM\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/submit-form/",
          "host": ["{{baseUrl}}"],
          "path": ["submit-form", ""]
        },
        "description": "Classic 'Bobby Tables' payload in FirstName. Expected: input is sanitized/escaped and no raw DB error is leaked - the endpoint should not 500."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('No server error (not a 5xx)', function () {",
              "    pm.expect(pm.response.code).to.be.below(500);",
              "});",
              "",
              "pm.test('No raw SQL/DB error leaked in response body', function () {",
              "    const body = pm.response.text().toLowerCase();",
              "    const leakPatterns = ['sql syntax', 'sqlstate', 'ora-', 'mysqlexception', 'unclosed quotation', 'sqlite error', 'pg::', 'syntax error at or near'];",
              "    leakPatterns.forEach(function (pattern) {",
              "        pm.expect(body).to.not.include(pattern);",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
